# Sao chép thành .env ở máy cá nhân; không commit tệp .env chứa khoá.
ENABLED_MODELS=llm
LLM_BACKEND=local
LLM_MODEL=Qwen/Qwen2.5-0.5B-Instruct
EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# macOS mặc định 1 để tránh lỗi PyTorch/FAISS; đặt 0 để dùng mặc định PyTorch.
TORCH_NUM_THREADS=1

# Khi dùng OpenAI, Gemini OpenAI-compatible hoặc Groq, bỏ dấu # ở các dòng dưới,
# đổi backend và điền khoá. Gemini ví dụ: https://generativelanguage.googleapis.com/v1beta/openai
# LLM_BACKEND=openai_compatible
# LLM_API_KEY=replace-me
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_MODEL=gpt-4o-mini
# LLM_REQUEST_TIMEOUT=60

MAX_UPLOAD_MB=8
CORS_ORIGINS=http://localhost:5173,http://localhost:8501
